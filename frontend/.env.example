# Variables de entorno del frontend YucaAI
# Ejemplo de URL: http://localhost:8000/api
VITE_API_BASE_URL=
VITE_API_HEALTH_PATH=/health
VITE_API_PREDICT_PATH=/predict
VITE_API_IMAGE_FIELD=file
VITE_API_TIMEOUT_MS=30000

# Opcionales: nombre visual y model_id para el único modelo del servidor
VITE_MODEL_NAME=
VITE_API_MODEL_ID=
VITE_API_MODEL_FIELD=

VITE_IMAGE_PLANT=images/yuca.webp
VITE_IMAGE_LEAF=images/yuca_hoja.webp
